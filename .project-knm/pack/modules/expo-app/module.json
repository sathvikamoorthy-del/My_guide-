{
  "id": "expo-app",
  "name": "Expo app (React Native)",
  "version": "1.0.0",
  "type": "mobile-ui",
  "tier": "full",
  "description": "Mobile app on Expo: Expo Router with bottom tabs, auth gate with secure token storage, React Native Paper, a typed API client, and loading / empty / error states.",
  "provides": [
    "mobile-ui",
    "router",
    "auth",
    "http-client"
  ],
  "requires": [],
  "dependencies": [],
  "conflicts": [],
  "config": [
    {
      "key": "EXPO_PUBLIC_API_URL",
      "question": "Base URL of the API this app talks to (leave empty to use the web app's API in app.json extra.apiUrl)?",
      "required": false,
      "default": "http://localhost:3000"
    }
  ],
  "env": [
    "EXPO_PUBLIC_API_URL"
  ],
  "variants": [
    {
      "id": "ts-expo-53",
      "language": "typescript",
      "framework": "expo",
      "tested": {
        "node": ">=18",
        "expo": "~53.0.0",
        "react-native": "~0.79.0"
      },
      "files": [
        "app.json",
        "eas.json",
        "jest.config.js",
        "app/_layout.tsx",
        "app/(auth)/_layout.tsx",
        "app/(auth)/sign-in.tsx",
        "app/(tabs)/_layout.tsx",
        "app/(tabs)/index.tsx",
        "app/(tabs)/settings.tsx",
        "app/+not-found.tsx",
        "src/api/client.ts",
        "src/auth/authGate.ts",
        "src/auth/tokenStore.ts",
        "src/auth/AuthProvider.tsx",
        "src/auth/signInMessage.ts",
        "src/ui/StateViews.tsx"
      ],
      "packages": {
        "expo": "~53.0.20",
        "expo-router": "~5.1.3",
        "expo-secure-store": "~14.2.3",
        "expo-linking": "~7.1.7",
        "expo-constants": "~17.1.7",
        "expo-status-bar": "~2.2.3",
        "react": "19.0.0",
        "react-native": "0.79.5",
        "react-native-paper": "^5.13.0",
        "react-native-safe-area-context": "5.4.0",
        "react-native-screens": "~4.11.1",
        "@expo/vector-icons": "^14.1.0",
        "jest": "^29.7.0",
        "jest-expo": "~53.0.9",
        "@testing-library/react-native": "^13.2.0",
        "@types/react": "~19.0.10",
        "@types/node": "^22.0.0",
        "@types/jest": "^29.5.12"
      },
      "adaptationPoints": [
        {
          "file": "src/auth/AuthProvider.tsx",
          "what": "sign-in route and the shape of its answer, how the session is restored"
        },
        {
          "file": "src/api/client.ts",
          "what": "error mapping, retry policy, base URL source"
        },
        {
          "file": "app/(tabs)/_layout.tsx",
          "what": "tabs, titles, icons"
        },
        {
          "file": "app.json",
          "what": "app name, slug, scheme; android.package and ios.bundleIdentifier (com.example.mobile is a placeholder: set your own before building)"
        }
      ],
      "extensionPoints": [
        {
          "glue": "providers",
          "register": "AuthProvider",
          "order": "inner",
          "from": "src/auth/AuthProvider.tsx"
        }
      ],
      "tests": {
        "contract": [
          "tests/contract/client.test.ts",
          "tests/contract/authGate.test.ts",
          "tests/contract/tokenStore.test.ts",
          "tests/contract/AuthProvider.test.tsx",
          "tests/contract/StateViews.test.tsx",
          "tests/contract/screens.test.tsx"
        ],
        "fit": [
          "tests/fit/glue.test.tsx"
        ]
      }
    },
    {
      "id": "js-expo-53",
      "language": "javascript",
      "framework": "expo",
      "tested": {
        "node": ">=18",
        "expo": "~53.0.0",
        "react-native": "~0.79.0"
      },
      "files": [
        "app.json",
        "eas.json",
        "jest.config.js",
        "app/_layout.jsx",
        "app/(auth)/_layout.jsx",
        "app/(auth)/sign-in.jsx",
        "app/(tabs)/_layout.jsx",
        "app/(tabs)/index.jsx",
        "app/(tabs)/settings.jsx",
        "app/+not-found.jsx",
        "src/api/client.js",
        "src/auth/authGate.js",
        "src/auth/tokenStore.js",
        "src/auth/AuthProvider.jsx",
        "src/auth/signInMessage.js",
        "src/ui/StateViews.jsx"
      ],
      "packages": {
        "expo": "~53.0.20",
        "expo-router": "~5.1.3",
        "expo-secure-store": "~14.2.3",
        "expo-linking": "~7.1.7",
        "expo-constants": "~17.1.7",
        "expo-status-bar": "~2.2.3",
        "react": "19.0.0",
        "react-native": "0.79.5",
        "react-native-paper": "^5.13.0",
        "react-native-safe-area-context": "5.4.0",
        "react-native-screens": "~4.11.1",
        "@expo/vector-icons": "^14.1.0",
        "jest": "^29.7.0",
        "jest-expo": "~53.0.9",
        "@testing-library/react-native": "^13.2.0"
      },
      "adaptationPoints": [
        {
          "file": "src/auth/AuthProvider.jsx",
          "what": "sign-in route and the shape of its answer, how the session is restored"
        },
        {
          "file": "src/api/client.js",
          "what": "error mapping, retry policy, base URL source"
        },
        {
          "file": "app/(tabs)/_layout.jsx",
          "what": "tabs, titles, icons"
        },
        {
          "file": "app.json",
          "what": "app name, slug, scheme; android.package and ios.bundleIdentifier (com.example.mobile is a placeholder: set your own before building)"
        }
      ],
      "extensionPoints": [
        {
          "glue": "providers",
          "register": "AuthProvider",
          "order": "inner",
          "from": "src/auth/AuthProvider.jsx"
        }
      ],
      "tests": {
        "contract": [
          "tests/contract/client.test.js",
          "tests/contract/authGate.test.js",
          "tests/contract/tokenStore.test.js",
          "tests/contract/AuthProvider.test.jsx",
          "tests/contract/StateViews.test.jsx",
          "tests/contract/screens.test.jsx"
        ],
        "fit": [
          "tests/fit/glue.test.jsx"
        ]
      }
    }
  ]
}
